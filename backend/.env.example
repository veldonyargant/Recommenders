# Configuration de base (ne pas modifier)
MONGO_URL=mongodb://localhost:27017
DB_NAME=spacio_db

# Configuration email SMTP pour notifications automatiques
# À configurer avec vos informations Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-app-password-gmail
NOTIFICATION_EMAIL=spacioplusservices@gmail.com
EMAIL_FROM=noreply@spacioplus.ca

# Instructions pour configurer Gmail:
# 1. Activer l'authentification à 2 facteurs sur votre compte Gmail
# 2. Générer un "App Password" dans Sécurité > Mots de passe d'applications
# 3. Utiliser ce mot de passe d'application comme SMTP_PASSWORD
# 4. Remplacer votre-email@gmail.com par votre vraie adresse Gmail